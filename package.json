{
  "name": "daymark-habits",
  "version": "0.2.1",
  "private": true,
  "description": "Habit and routine tracking for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "package": "npm run build && node scripts/package.mjs",
    "pretest": "node esbuild.config.mjs production",
    "lint": "eslint .",
    "check": "npm run lint && npm run build && npm test && node scripts/check-release.mjs",
    "test:ui": "node scripts/polish-ui-check.mjs",
    "test:export-ui": "node scripts/export-ui-check.mjs",
    "test:board-stats-ui": "node scripts/board-stats-ui-check.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.25.3",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "^1.8.7",
    "typescript": "5.9.3"
  },
  "author": "niyoj",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niyoj/daymark.git"
  },
  "homepage": "https://github.com/niyoj/daymark#readme",
  "bugs": {
    "url": "https://github.com/niyoj/daymark/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  }
}
